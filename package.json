{
  "name": "caddy-map-dashboard",
  "version": "0.1.0",
  "private": false,
  "description": "A Caddy-driven service portal with quick links, route inspection, and lightweight status.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && ./ops/prepare-standalone.sh",
