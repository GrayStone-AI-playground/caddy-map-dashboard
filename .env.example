# Optional: live admin API source
# CADDY_ADMIN_URL=http://127.0.0.1:2019/config/

# Optional: use a saved JSON config instead of the admin API
# CADDY_CONFIG_JSON_PATH=/absolute/path/to/caddy-config.json

# Optional: adapt a local Caddyfile into JSON
# CADDYFILE_PATH=/absolute/path/to/Caddyfile
# CADDY_BIN=caddy
# CADDY_ADAPTER=caddyfile

# Optional: trust self-signed/internal certificates during probes
# CADDY_DASHBOARD_ALLOW_SELF_SIGNED=true

# Optional: force demo mode even when live sources exist
# CADDY_DASHBOARD_DEMO_MODE=false

# Probe tuning
# CADDY_DASHBOARD_FRONTEND_TIMEOUT_MS=1500
# CADDY_DASHBOARD_BACKEND_TIMEOUT_MS=1200

# Client polling
# NEXT_PUBLIC_REFRESH_INTERVAL_MS=10000
